# Local development defaults. Copy to .env and change values as needed.
POSTGRES_USER=roadwatch
POSTGRES_PASSWORD=roadwatch
POSTGRES_DB=roadwatch
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
FRAME_DELAY=0.15
CONF_THRES=0.25

# Optional host-side values for running Python services outside Docker.
KAFKA_BOOTSTRAP=localhost:29092
POSTGRES_DSN=postgresql://roadwatch:roadwatch@localhost:5432/roadwatch
MODEL_WEIGHTS=./model/weights/best.pt
FRAMES_DIR=./data/frames

# Optional experiment tracking when training locally.
WANDB_API_KEY=
